# UNIDAD 3 Strudel

``` js
const { visualid } = createParams('visualid')
setcpm(45)

let chords = chord("<Cm9 Abmaj7>/4")

let harmony = chords.offset(1).voicing().sound("gm_epiano1:1")
  .room(0.5)
  .gain(0.7)
  .visualid("harmony")
$harmony: stack(harmony, harmony.osc())

let bass = n("<0!2 2*2 1>")
  .set(chords)
  .voicing()
  .sound("gm_acoustic_bass")
  .gain(0.8)
  .visualid("bass")
$bass: stack(bass, bass.osc())

let melody = chords.n("[2 <0 1 <3 4>>*2](3,8)")
  .room(0.75)
  .delay(0.25)
  .gain(0.9)
  .sound("gm_acoustic_bass")
  .visualid("melody")
$melody: stack(melody, melody.osc())

let openhat = sound("oh/4").visualid("drum_oh")
$openhat: stack(openhat, openhat.osc())

let hihats = n("[0 <1 3>]*2").sound("hh")
  .gain(0.5).visualid("drum_hh")
$hihats: stack(hihats, hihats.osc())
```
